{
  "appId": "com.thrishank.studio",
  "appName": "myProfile",
  "webDir": "www",
  "backgroundColor": "#f5f6f8",
  "android": {
    "allowMixedContent": false
  },
  "plugins": {
    "FirebaseAuthentication": {
      "skipNativeAuth": true,
      "providers": [
        "google.com"
      ]
    },
    "SystemBars": {
      "insetsHandling": "css",
      "initialViewportFitValueHint": "cover"
    }
  }
}